      "source": [
        "# ============================================================\n",
        "# SECTION 5 : FEATURE ENGINEERING\n",
        "# ============================================================\n",
        "\n",
        "df_fe = df.copy()\n",
        "\n",
        "print(df_fe.shape)\n",
        "\n",
        "df_fe[\"datetime\"] = pd.to_datetime(df_fe[\"ts\"], unit=\"s\")\n",
        "\n",
        "df_fe[\"hour\"] = df_fe[\"datetime\"].dt.hour\n",
        "df_fe[\"minute\"] = df_fe[\"datetime\"].dt.minute\n",
        "df_fe[\"day\"] = df_fe[\"datetime\"].dt.day\n",
        "\n",
        "df_fe.drop(columns=[\"datetime\"], inplace=True)\n",
        "\n",
        "df_fe[\"orig_ipv6\"] = df_fe[\"id.orig_h\"].str.contains(\":\").astype(int)\n",
        "df_fe[\"resp_ipv6\"] = df_fe[\"id.resp_h\"].str.contains(\":\").astype(int)\n",
        "\n",
        "df_fe[\"resp_multicast\"] = (\n",
        "    df_fe[\"id.resp_h\"].str.startswith(\"ff\")\n",
        ").astype(int)\n",
        "\n",
        "df_fe[\"orig_loopback\"] = (\n",
        "    df_fe[\"id.orig_h\"].str.startswith(\"127.\")\n",
        ").astype(int)\n",
        "\n",
        "df_fe.drop(\n",
        "    columns=[\n",
        "        \"id.orig_h\",\n",
        "        \"id.resp_h\"\n",
        "    ],\n",
        "    inplace=True\n",
        ")\n",
        "\n",
        "well_known = 1024\n",
        "\n",
        "df_fe[\"orig_ephemeral\"] = (\n",
        "    df_fe[\"id.orig_p\"] > well_known\n",
        ").astype(int)\n",
        "\n",
        "df_fe[\"resp_ephemeral\"] = (\n",
        "    df_fe[\"id.resp_p\"] > well_known\n",
        ").astype(int)\n",
        "\n",
        "df_fe[\"is_http\"] = (df_fe[\"id.resp_p\"] == 80).astype(int)\n",
        "df_fe[\"is_https\"] = (df_fe[\"id.resp_p\"] == 443).astype(int)\n",
        "df_fe[\"is_dns\"] = (df_fe[\"id.resp_p\"] == 53).astype(int)\n",
        "\n",
        "df_fe[\"total_bytes\"] = (\n",
        "    df_fe[\"orig_bytes\"] +\n",
        "    df_fe[\"resp_bytes\"]\n",
        ")\n",
        "\n",
        "df_fe[\"total_pkts\"] = (\n",
        "    df_fe[\"orig_pkts\"] +\n",
        "    df_fe[\"resp_pkts\"]\n",
        ")\n",
        "\n",
        "df_fe[\"byte_ratio\"] = (\n",
        "    df_fe[\"orig_bytes\"] /\n",
        "    (df_fe[\"resp_bytes\"] + 1)\n",
        ")\n",
        "\n",
        "df_fe[\"packet_ratio\"] = (\n",
        "    df_fe[\"orig_pkts\"] /\n",
        "    (df_fe[\"resp_pkts\"] + 1)\n",
        ")\n",
        "\n",
        "df_fe[\"bytes_per_packet\"] = (\n",
        "    df_fe[\"total_bytes\"] /\n",
        "    (df_fe[\"total_pkts\"] + 1)\n",
        ")\n",
        "\n",
        "df_fe[\"bytes_per_second\"] = (\n",
        "    df_fe[\"total_bytes\"] /\n",
        "    (df_fe[\"duration\"] + 1)\n",
        ")\n",
        "\n",
        "df_fe[\"pkts_per_second\"] = (\n",
        "    df_fe[\"total_pkts\"] /\n",
        "    (df_fe[\"duration\"] + 1)\n",
        ")\n",
        "\n",
        "df_fe[\"zero_response\"] = (\n",
        "    df_fe[\"resp_bytes\"] == 0\n",
        ").astype(int)\n",
        "\n",
        "df_fe[\"short_connection\"] = (\n",
        "    df_fe[\"duration\"] < 1\n",
        ").astype(int)\n",
        "\n",
        "df_fe[\"single_packet\"] = (\n",
        "    df_fe[\"total_pkts\"] == 1\n",
        ").astype(int)\n",
        "\n",
        "categorical = [\n",
        "    \"proto\",\n",
        "    \"service\",\n",
        "    \"conn_state\",\n",
        "    \"history\",\n",
        "    \"local_resp\"\n",
        "]\n",
        "\n",
        "df_fe = pd.get_dummies(\n",
        "    df_fe,\n",
        "    columns=categorical,\n",
        "    drop_first=True\n",
        ")\n",
        "\n",
        "labels = df_fe[\"label\"]\n",
        "\n",
        "X = df_fe.drop(columns=[\"label\"])"
